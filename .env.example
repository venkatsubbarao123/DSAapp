# ==============================================================================
# DSAapp Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO REPOSITORY
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Application Environment: development | production | test
ENVIRONMENT=development
APP_NAME=dsaapp-api
API_V1_STR=/api/v1

# Security & Cryptography
# In production, SECRET_KEY must be a cryptographically secure 64+ char random string
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_64_chars_length_required_here

# Database Configuration
# Local dev default: SQLite (async driver)
DATABASE_URL=sqlite+aiosqlite:///./dsaapp.db
# Production example: postgresql+asyncpg://dsaapp_user:strong_password@postgres:5432/dsaapp_prod
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Cache & Queue Broker
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# CORS & Host Validation
# PRODUCTION: must contain ONLY the deployed frontend origin. No wildcards.
# Accepts a JSON array, a comma-separated list, or a single value.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# PRODUCTION: REQUIRED. TrustedHostMiddleware returns 400 for any Host header it
# does not recognise. Render health-checks via the generated hostname, so if the
# backend domain is missing here /health answers 400 and the deploy never goes
# LIVE. Wildcards are supported, e.g. ["*.onrender.com"].
# Accepts a JSON array, a comma-separated list, or a single value.
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# Request Size & Security Boundaries
MAX_REQUEST_SIZE_BYTES=10485760
MAX_JSON_SIZE_BYTES=1048576
SECURE_COOKIES=false
SESSION_COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# Logging
LOG_LEVEL=INFO
STRUCTURED_LOGS=true

# API documentation (/docs, /redoc, /openapi.json).
# Disabled in production by default because it exposes the full route/schema
# surface. Set true only if you need a browsable production contract.
ENABLE_API_DOCS=false

# AI Provider Abstraction
# Server-side only. These values are NEVER exposed to the frontend bundle.
#   mock   -> deterministic offline provider (tests / no key)
#   gemini -> Google Gemini (production default)
#   openai -> OpenAI-compatible provider
AI_PROVIDER=gemini
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Google Gemini (required when AI_PROVIDER=gemini).
# PRODUCTION: set the real key ONLY in the hosting provider's secret store.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-flash-lite-latest

# Hard upper bound (seconds) for a single provider call. The AI endpoints always
# answer within this budget plus DB overhead, falling back to the deterministic
# provider if Gemini is unavailable. Keep the frontend AI_REQUEST_TIMEOUT_MS
# (45s) greater than this value.
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_TOKENS=2000
AI_MAX_OUTPUT_TOKENS=1500
AI_RATE_LIMIT_PER_MINUTE=20
AI_FREE_TIER_DAILY_LIMIT=15
AI_PREMIUM_TIER_DAILY_LIMIT=150

# Online Judge & Sandbox
# docker -> real isolated containers (required for production submissions)
# mock   -> deterministic driver for tests only. REJECTED in production because
#           it would return fabricated verdicts.
JUDGE_SANDBOX_DRIVER=auto
# Set to false on hosts without a container runtime (e.g. Render web services).
# The API still starts; submissions are queued but never executed. No security
# control is relaxed and no code is ever run inside the FastAPI process.
JUDGE_ENABLED=true
JUDGE_WORKER_CONCURRENCY=2
JUDGE_JOB_TIMEOUT_SECONDS=30
JUDGE_HEARTBEAT_INTERVAL_SECONDS=5

# Authentication & Tokens (Phase 2)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Premium Entitlement & Pricing (Phase 2)
PREMIUM_PRICE=1
PREMIUM_CURRENCY=USD
PREMIUM_PLAN_ID=plan_premium_monthly
PREMIUM_DURATION_DAYS=30

# PhonePe Payment Gateway (Phase 2)
# PAYMENT_MODE options: development_manual | phonepe_sandbox | phonepe_production
PAYMENT_MODE=development_manual
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_HOST_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_CALLBACK_URL=http://localhost:8000/api/v1/payments/webhook
PHONEPE_REDIRECT_URL=http://localhost:5173/status

